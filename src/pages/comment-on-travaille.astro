---
import Base from '../layouts/Base.astro';
import Entete from '../components/Entete.astro';
import Section from '../components/Section.astro';
import VideoProcess from '../components/VideoProcess.astro';
import FinalCta from '../components/FinalCta.astro';
import { CALENDLY } from '../config';
import { CHAPITRES, VIDEO, videoJsonld } from '../data/video-process';
const jsonld = videoJsonld(Astro.site!, true);
const lien = (chemin: string) => new URL(chemin, Astro.site).href;
---
<Base
  title="Déroulement d'un audit administratif en vidéo"
  description="Voyez en 1 min 21 s comment se déroule le Diagnostic Présence d'OptiAI : les quatre étapes, les six livrables, les engagements et la garantie. Transcription complète incluse."
  image={VIDEO.affiche}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <meta slot="head" property="og:video" content={lien(VIDEO.mp4)} />
  <meta slot="head" property="og:video:type" content="video/mp4" />
  <meta slot="head" property="og:video:width" content="1920" />
  <meta slot="head" property="og:video:height" content="1080" />
  <Entete
    fil={[{ href: '/diagnostic-presence', label: 'Diagnostic Présence' }, { label: 'La vidéo' }]}
    kicker="La vidéo"
    titre="Comment on travaille, étape par étape."
    lead="Le Diagnostic Présence se déroule en quatre étapes, sur trois à quatre semaines : une séance de deux heures avec vous, 30 à 45 minutes avec chaque gestionnaire, une note sur 30 pour chaque irritant, puis six livrables et une feuille de route."
  >
    <VideoProcess resume={false} />
    <div class="actions">
      <a href={CALENDLY} class="btn btn-primary" target="_blank" rel="noopener">Réserver un appel découverte <span class="fl" aria-hidden="true">→</span></a>
      <a href="/diagnostic-presence" class="btn btn-secondary">Voir le Diagnostic Présence</a>
    </div>
  </Entete>

  <Section id="transcription" num="01" kicker="La transcription" titre="Ce que dit la vidéo, chapitre par chapitre." fond="card" lead="Cliquez sur un temps pour reprendre la vidéo à ce moment.">
    <ol class="video-chapitres">
      {CHAPITRES.map((c) => (
        <li>
          <a class="mono" href={`${VIDEO.page}?t=${c.t}`} data-t={c.t} aria-label={`Lire à partir de ${c.temps}`}>{c.temps}</a>
          <div>
            <h3>{c.titre}</h3>
            <p>{c.texte}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="caption" style="margin-top:var(--space-6)">Dans la vidéo, le tableau noté sur 30 est un exemple fictif. La méthode complète est décrite sur la page <a class="lien" href="/methode">La méthode</a>.</p>
  </Section>

  <FinalCta />

  <script>
    // Lien vers un moment de la vidéo (?t=) : la position est réglée, la lecture reste au choix du visiteur.
    const video = document.querySelector<HTMLVideoElement>('.video-process video');
    const depart = Number(new URLSearchParams(location.search).get('t'));
    if (video) {
      if (depart > 0) video.currentTime = depart;
      document.querySelectorAll<HTMLAnchorElement>('[data-t]').forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          video.currentTime = Number(a.dataset.t);
          history.replaceState(null, '', a.href);
          video.scrollIntoView({ block: 'center' });
          video.play().catch(() => {});
        });
      });
    }
  </script>
</Base>

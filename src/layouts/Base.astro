---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { COURRIEL, LINKEDIN, NOM_LEGAL } from '../config';
interface Props { title: string; description: string; noindex?: boolean; type?: 'website' | 'article'; }
const { title, description, noindex = false, type = 'website' } = Astro.props;
const chemin = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(chemin, Astro.site);
const fullTitle = title.includes('OptiAI') ? title : `${title} · OptiAI`;
// Données structurées de l'entreprise, sur toutes les pages (Google et assistants IA).
const site = Astro.site!.href.replace(/\/$/, '');
const fondateur = {
  '@type': 'Person', '@id': `${site}/a-propos#denis`, name: 'Denis Kojo', url: `${site}/a-propos`,
  jobTitle: 'Fondateur', image: `${site}/dennis.webp`, ...(LINKEDIN && { sameAs: [LINKEDIN] }),
};
const graphe: Record<string, unknown>[] = [{
  '@type': 'ProfessionalService', '@id': `${site}/#entreprise`, name: NOM_LEGAL, alternateName: 'OptiAI',
  url: `${site}/`, email: COURRIEL, image: `${site}/dennis.webp`, logo: `${site}/favicon.svg`,
  description: "Audit administratif pour les dirigeants de PME, de réseaux et de petits bureaux professionnels du Québec : écrire les processus, corriger, puis automatiser seulement ce qui en vaut la peine.",
  areaServed: { '@type': 'AdministrativeArea', name: 'Québec' }, inLanguage: 'fr-CA',
  knowsAbout: ['Loi 25', 'Processus administratifs', 'Automatisation administrative', 'Documentation des processus', 'Microsoft 365'],
  founder: fondateur,
}];
if (chemin === '/') graphe.push({ '@type': 'WebSite', '@id': `${site}/#site`, url: `${site}/`, name: 'OptiAI', inLanguage: 'fr-CA', publisher: { '@id': `${site}/#entreprise` } });
const jsonldSite = { '@context': 'https://schema.org', '@graph': graphe };
---
<!doctype html>
<html lang="fr-CA">
<head>
  <meta charset="utf-8">
  <script is:inline>document.documentElement.classList.add('js')</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fbfbf8">
  <meta name="color-scheme" content="light">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:type" content={type}>
  <meta property="og:locale" content="fr_CA">
  <meta property="og:site_name" content="Solutions d'automatisation OptiAI">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL('/dennis.webp', Astro.site)}>
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="alternate" type="application/rss+xml" title="Blogue OptiAI" href="/rss.xml">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/ibm-plex-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <script type="application/ld+json" set:html={JSON.stringify(jsonldSite)} />
  <slot name="head" />
</head>
<body>
  <a class="saut" href="#contenu">Aller au contenu</a>
  <Nav />
  <main id="contenu">
    <slot />
  </main>
  <Footer />
  <script>
    // Apparition douce des blocs et tracé des trajets, une seule fois.
    const cibles = document.querySelectorAll('.revele, .steps.anime');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entrees) => {
        entrees.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('vu'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -10% 0px' });
      cibles.forEach((c) => io.observe(c));
    } else {
      cibles.forEach((c) => c.classList.add('vu'));
    }
  </script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
</body>
</html>

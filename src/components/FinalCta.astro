---
import { CALENDLY } from '../config';
interface Props { titre?: string; texte?: string; }
const {
  titre = "Regardons ensemble ce que l'administratif vous prend.",
  texte = "30 minutes, au téléphone ou en visio. Vous décrivez votre semaine, on repère ce qui pourrait tourner sans vous, et vous repartez avec une première idée claire, qu'on travaille ensemble ou non.",
} = Astro.props;
---
<section class="cloture" aria-labelledby="cloture-titre">
  <div class="wrap">
    <h2 id="cloture-titre">{titre}</h2>
    <p>{texte}</p>
    <div class="actions">
      <a class="onglet-btn" href={CALENDLY} target="_blank" rel="noopener">Réserver un appel découverte
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
      </a>
      <a class="lien" href="/auto-diagnostic">Ou mesurez-vous d'abord en 2 minutes</a>
    </div>
    <p class="signature">Vous avez bâti votre entreprise pour faire votre métier. <span>Pas pour en porter la paperasse le vendredi soir.</span></p>
  </div>
</section>

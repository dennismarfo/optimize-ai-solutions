---
// Le symbole « Le trajet » : grille 3 x 3, un trajet vert qui aboutit au point orange.
interface Props { inverse?: boolean; size?: number; href?: string; descripteur?: boolean; }
const { inverse = false, size = 36, href = '/', descripteur = true } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag href={href} class:list={['logo', { inverse }]} aria-label="OptiAI, Solutions d'automatisation, accueil">
  <svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
    <circle class="n" cx="40" cy="8" r="3" /><circle class="n" cx="8" cy="24" r="3" />
    <circle class="n" cx="8" cy="40" r="3" /><circle class="n" cx="24" cy="40" r="3" />
    <path class="r" d="M8 8 L24 8 L24 24 L40 24 L40 40" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
    <circle class="s" cx="8" cy="8" r="4" />
    <circle class="d" cx="40" cy="40" r="6.5" />
  </svg>
  <span class="logo-nom" aria-hidden="true">OptiAI<span class="point">.</span>{descripteur && <span class="logo-desc">Solutions d'automatisation</span>}</span>
</Tag>

---
---
<div id="demo" class="chrono-card">
      <div class="chrono-top">
        <div class="chrono-label">Chrono du rappel</div>
        <div class="live"><i></i>Ligne active</div>
      </div>
      <div id="timer">—:—<small>.—</small></div>
      <p class="chrono-hint">Ne nous croyez pas. <strong>Chronométrez-nous.</strong> Remplissez le formulaire comme le ferait un de vos clients. Votre téléphone va sonner.</p>
      <form id="demo-form" autocomplete="on">
        <div class="f-row">
          <input type="text" name="prenom" placeholder="Votre prénom" required>
          <select name="domaine" required>
            <option value="" disabled selected>Votre domaine</option>
            <option value="cvac">CVAC / Thermopompes</option>
            <option value="nettoyage">Nettoyage</option>
            <option value="paysagement">Paysagement</option>
            <option value="toiture">Toiture</option>
            <option value="renovation">Rénovation</option>
            <option value="autre">Autre service</option>
          </select>
        </div>
        <input type="tel" name="telephone" id="tel" placeholder="Votre téléphone (ex. 438 600-2855)" inputmode="tel" autocomplete="tel" maxlength="16" required>
        <p class="tel-err" id="tel-err" role="alert"></p>
        <input type="email" name="courriel" id="courriel" placeholder="Votre courriel" autocomplete="email" required>
        <input type="text" name="entreprise" style="position:absolute;left:-9999px" tabindex="-1" autocomplete="off">
        <label class="consent"><input type="checkbox" name="consentement" value="1">J'accepte de recevoir un texto de suivi après l'appel (optionnel).</label>
        <button type="submit" class="btn-demo">Faites sonner mon téléphone</button>
      </form>
      <div id="form-status"></div>
      <p class="chrono-note">Aucune liste, aucun spam. Votre courriel sert uniquement à confirmer le rendez-vous.</p>
    </div>
<script is:inline>
// ====== CONFIG ======
const WEBHOOK_URL = "https://n8n.srv775529.hstgr.cloud/webhook/optiai-demo-rappel";
// ====================


// ===== Validation du numéro : Canada seulement (permissions Twilio) =====
const CA_AREA = new Set(['204','226','236','249','250','263','289','306','343','354','365','367','368','382','387','403','416','418','428','431','437','438','450','468','474','506','514','519','548','579','581','584','587','604','613','639','647','672','683','705','709','742','753','778','780','782','807','819','825','867','873','879','902','905']);
const telEl = document.getElementById('tel');
const telErrEl = document.getElementById('tel-err');

function chiffres(v){ return String(v).replace(/\D/g, ''); }

function verifierTel(v){
  let d = chiffres(v);
  if (d.length === 11 && d.startsWith('1')) d = d.slice(1);
  if (d.length === 0) return { ok:false, msg:'' };
  if (d.length < 10) return { ok:false, msg:'Il manque des chiffres : un numéro d’ici en compte 10.' };
  if (d.length > 10) return { ok:false, msg:'Trop de chiffres. Un numéro canadien en compte 10.' };
  if (!CA_AREA.has(d.slice(0,3))) return { ok:false, msg:'La démo appelle uniquement les numéros canadiens. Pour un essai ailleurs, écrivez-nous.' };
  return { ok:true, tel:'+1' + d };
}

function afficherErreurTel(msg){
  if (msg) { telErrEl.textContent = msg; telErrEl.style.display = 'block'; telEl.classList.add('invalide'); }
  else { telErrEl.style.display = 'none'; telEl.classList.remove('invalide'); }
}

// Mise en forme pendant la saisie : (438) 600-2855
telEl.addEventListener('input', () => {
  let d = chiffres(telEl.value);
  if (d.length === 11 && d.startsWith('1')) d = d.slice(1);
  d = d.slice(0, 10);
  let out = d;
  if (d.length > 6) out = '(' + d.slice(0,3) + ') ' + d.slice(3,6) + '-' + d.slice(6);
  else if (d.length > 3) out = '(' + d.slice(0,3) + ') ' + d.slice(3);
  else if (d.length > 0) out = '(' + d;
  telEl.value = out;
  if (telErrEl.style.display === 'block') afficherErreurTel(verifierTel(telEl.value).msg);
});
telEl.addEventListener('blur', () => afficherErreurTel(verifierTel(telEl.value).msg));

// Chrono + form
const form = document.getElementById('demo-form');
const timerEl = document.getElementById('timer');
const statusEl = document.getElementById('form-status');
let t0 = null, raf = null;

function fmt(ms){
  const s = Math.floor(ms/1000), m = Math.floor(s/60);
  const ds = Math.floor((ms % 1000)/100);
  return String(m).padStart(2,'0') + ':' + String(s%60).padStart(2,'0') + '<small>.' + ds + '</small>';
}
function tick(){ timerEl.innerHTML = fmt(performance.now() - t0); raf = requestAnimationFrame(tick); }

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(form).entries());
  if (data.entreprise) return; // honeypot
  const v = verifierTel(data.telephone);
  if (!v.ok) { afficherErreurTel(v.msg || 'Entrez votre numéro de téléphone.'); telEl.focus(); return; }
  afficherErreurTel('');
  data.telephone = v.tel; // format E.164 : +1XXXXXXXXXX
  const btn = form.querySelector('button');
  btn.disabled = true; btn.textContent = 'Envoi…';
  try {
    const r = await fetch(WEBHOOK_URL, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ prenom: data.prenom, telephone: data.telephone, courriel: String(data.courriel || '').trim().toLowerCase(), domaine: data.domaine, consentement: data.consentement === '1' })
    });
    if (!r.ok) throw new Error();
    let rep = null;
    try { rep = await r.json(); } catch(e) {}
    if (rep && rep.ok === false) {
      btn.disabled = false; btn.textContent = 'Faites sonner mon téléphone';
      statusEl.style.display = 'block';
      statusEl.style.color = '#f59a62';
      statusEl.innerHTML = (rep.message || "La démonstration n'est pas disponible pour ce numéro en ce moment.")
        + ' <a href="#reserver" style="color:#fff;border-bottom:1px solid #f59a62">Réservez le mini-test</a> : c\'est là que vous avez vos vrais chiffres.';
      return;
    }
    t0 = performance.now(); tick();
    form.style.display = 'none';
    statusEl.style.display = 'block';
    statusEl.textContent = 'C’est parti. Gardez votre téléphone à la main. Et comptez.';
    timerEl.style.cursor = 'pointer';
    timerEl.title = 'Cliquez quand votre téléphone sonne';
    timerEl.addEventListener('click', () => {
      cancelAnimationFrame(raf);
      statusEl.textContent = 'Voilà. Ça, c’est ce que chacun de vos clients vivrait.';
    }, { once: true });
  } catch(err) {
    btn.disabled = false; btn.textContent = 'Faites sonner mon téléphone';
    statusEl.style.display = 'block'; statusEl.style.color = '#f59a62';
    statusEl.textContent = 'Petit pépin technique. Réessayez, ou réservez le mini-test plus bas.';
  }
});

</script>

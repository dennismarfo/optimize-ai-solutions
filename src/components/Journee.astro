---
const moments = [
  { h: '7 h 30', ou: 'Avant d\'ouvrir', titre: 'Le point du matin est déjà prêt', texte: "Ce qui est payé, ce qui est en retard, ce qui attend votre signature. Une page, dans votre boîte, avant le premier café.",
    fiche: [['Factures payées hier', '4'], ['En retard de plus de 15 jours', '2'], ['À signer', '1 contrat']] },
  { h: '9 h 15', ou: 'Au bureau', titre: 'Les questions des employés ont trouvé leur réponse', texte: "Vacances, heures, attestations : les réponses viennent du guide de l'employé. Vous ne voyez que les cas qui demandent votre jugement.",
    fiche: [['Questions reçues', '7'], ['Répondues par la règle', '6'], ['Pour vous', '1']] },
  { h: '12 h 00', ou: 'Entre deux rendez-vous', titre: 'La facture de la semaine se monte seule', texte: 'Les présences arrivent, la facture se prépare dans votre modèle. Vous relisez, vous envoyez. Plus de recopie.',
    fiche: [['Présences reçues', '3 sites'], ['Facture préparée', '1'], ['Votre part', 'Relire et envoyer']] },
  { h: '16 h 40', ou: 'Fin de journée', titre: 'Les reçus sont rangés au fur et à mesure', texte: 'Chaque photo de reçu est lue, classée et associée à sa dépense. Le total du mois colle aux remboursements.',
    fiche: [['Reçus du jour', '5'], ['Rapprochés', '5'], ['À vérifier', '0']] },
  { h: '21 h 10', ou: 'À la maison', titre: 'Vous êtes en famille. Rien ne remonte.', texte: "Une employée demande son solde de vacances. Elle a sa réponse, sourcée. Vous n'êtes pas dérangé.",
    fiche: [['Question', 'Solde de vacances'], ['Zone', 'Jaune, accès limité'], ['Réponse', 'Envoyée à 21 h 12']] },
  { h: '7 h 00', ou: 'Le lendemain', titre: 'Les relances sont parties à l\'heure', texte: 'Les factures en retard ont reçu leur relance graduée. Personne n\'a eu besoin d\'y penser.',
    fiche: [['Relances envoyées', '2'], ['Ton', 'Poli, daté, sans menace'], ['Prochaine étape', 'Appel, si rien jeudi']] },
];
---
<div class="demo journee" id="journee">
  <div role="tablist" aria-label="Moments de la journée">
    {moments.map((m, i) => (
      <button role="tab" id={`j-tab-${i}`} aria-controls={`j-pan-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="mono">{m.h}</span><span>{m.ou}</span>
      </button>
    ))}
  </div>
  {moments.map((m, i) => (
    <div role="tabpanel" id={`j-pan-${i}`} aria-labelledby={`j-tab-${i}`} hidden={i !== 0}>
      <div class="moment">{m.h}</div>
      <span class="label ou">{m.ou}</span>
      <h3>{m.titre}</h3>
      <p>{m.texte}</p>
      <div class="fiche">{m.fiche.map(([k, v]) => <div><span>{k}</span><b>{v}</b></div>)}</div>
      <div class="nav-j">
        <button class="btn btn-secondary btn-sm j-prec" type="button" disabled={i === 0} aria-label="Moment précédent">←</button>
        <button class="btn btn-secondary btn-sm j-suiv" type="button" disabled={i === moments.length - 1} aria-label="Moment suivant">→</button>
        <span class="label">{i + 1} de {moments.length}</span>
      </div>
    </div>
  ))}
</div>
<script>
  const j = document.getElementById('journee');
  if (j) {
    const tabs = [...j.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const pans = [...j.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const aller = (k: number, focus = false) => {
      tabs.forEach((t, i) => { t.setAttribute('aria-selected', String(i === k)); t.tabIndex = i === k ? 0 : -1; });
      pans.forEach((p, i) => (p.hidden = i !== k));
      if (focus) tabs[k].focus();
      const liste = tabs[k].parentElement!;
      if (liste.scrollWidth > liste.clientWidth) liste.scrollTo({ left: tabs[k].offsetLeft - 16, behavior: 'smooth' });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => aller(i));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); aller((i + d + tabs.length) % tabs.length, true); }
      });
    });
    pans.forEach((p, i) => {
      p.querySelector('.j-prec')?.addEventListener('click', () => aller(i - 1));
      p.querySelector('.j-suiv')?.addEventListener('click', () => aller(i + 1));
    });
  }
</script>

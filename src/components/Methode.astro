---
interface Etape { titre: string; texte: string; points?: string[]; }
interface Props { etapes: Etape[]; }
const { etapes } = Astro.props;
---
<ol class="steps anime" style={`--n:${etapes.length}`}>
  {etapes.map((e, i) => (
    <li class="step">
      <span class="node" aria-hidden="true"></span>
      <div class="sn">{String(i + 1).padStart(2, '0')}</div>
      <h3>{e.titre}</h3>
      <p>{e.texte}</p>
      {e.points && <ul>{e.points.map((p) => <li>{p}</li>)}</ul>}
    </li>
  ))}
</ol>
